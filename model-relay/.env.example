# easyAI model-relay 环境变量模板
# 复制为 .env 后按需修改

MODEL_RELAY_HOST=0.0.0.0
MODEL_RELAY_PORT=8080
MODEL_RELAY_LOG_LEVEL=info
MODEL_RELAY_CONFIG_PATH=config.yaml

# SQLite 数据库路径
MODEL_RELAY_DB_PATH=data/relay.db

# 管理 API 鉴权 Key（创建/吊销 Access Key 等管理操作）
MODEL_RELAY_ADMIN_KEY=sk-admin-change-me

# 上游厂商 API Key（与 config.yaml 中 backends 的 api_key_env 对应）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
